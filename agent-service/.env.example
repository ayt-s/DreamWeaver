# DreamWeaver Agent 服务环境变量模板
# 使用方法：复制本文件为 .env 并填入你的真实值
#   cp .env.example .env
#
# ⚠️ .env 已被 .gitignore 排除，不会提交到仓库
# 获取 API Key：https://platform.agnes-ai.com/ 注册 → Settings → API Keys

# Agnes AI API 配置
AGNES_BASE_URL=https://apihub.agnes-ai.com/v1
# 你的 API Key（sk- 开头），从这里获取：https://platform.agnes-ai.com/
AGNES_API_KEY=sk-your-key-here

# 国内 Agnes 端点（同家供应商双账号扩容，官方允许；未配置则自动降级为单端点）
# gateway 会按 session 粘性路由 + 提交失败跨 provider failover
AGNES_BASE_URL_cn=
AGNES_API_KEY_cn=

# 模型（可按需切换）
AGNES_TEXT_MODEL=agnes-2.5-flash
AGNES_IMAGE_MODEL=agnes-image-2.5-flash
AGNES_VIDEO_FAST=agnes-video-2.5-flash
AGNES_VIDEO_HD=agnes-video-2.5

# 任务调度队列（排期）：同时执行的会话上限；超出的进入 FIFO 队列排队
# 调大 = 并发生成多但更易触发限流；调小 = 更稳但提交的任务排队更久
AGENT_MAX_CONCURRENT_SESSIONS=2
# 排队容量上限，提交超过该数返回 429
AGENT_SESSION_QUEUE_SIZE=200