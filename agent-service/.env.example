# DreamWeaver Agent 服务环境变量模板
# 使用方法：复制本文件为 .env 并填入你的真实值
#   cp .env.example .env
#
# ⚠️ .env 已被 .gitignore 排除，不会提交到仓库
# 获取 API Key：https://platform.agnes-ai.com/ 注册 → Settings → API Keys

# 国际Agnes AI API 配置
AGNES_BASE_URL=https://apihub.agnes-ai.com/v1
# 你的 API Key（sk- 开头），从这里获取：https://platform.agnes-ai.com/
AGNES_API_KEY=sk-your-key-here

# 国内 Agnes 端点（同家供应商的国内账号；未配置则自动降级为单端点）
# gateway 会按 session 粘性路由 + 提交失败跨 provider failover
AGNES_BASE_URL_cn=https://api.agnes-ai.cn/v1
# 你的 API Key（sk- 开头），从这里获取：https://platform.agnes-ai.cn/
AGNES_API_KEY_cn=

# 模型（可按需切换）
AGNES_TEXT_MODEL=agnes-2.5-flash
AGNES_IMAGE_MODEL=agnes-image-2.5-flash
AGNES_VIDEO_FAST=agnes-video-2.5-flash
AGNES_VIDEO_HD=agnes-video-2.5

# 任务调度队列（排期）：同时执行的会话上限；超出的进入 FIFO 队列排队
# 调大 = 并发生成多但更易触发限流；调小 = 更稳但提交的任务排队更久
AGENT_MAX_CONCURRENT_SESSIONS=2
# 排队容量上限，提交超过该数返回 429
AGENT_SESSION_QUEUE_SIZE=200

# 会话持久化（Redis 快照 + 启动自动恢复 + 心跳续期）
# agent 用 db=1，避免与 Java Redisson 的 dw:task:watchdog 混在 db0
AGENT_REDIS_URL=redis://127.0.0.1:6379/1
# state 快照 / progress TTL（秒），默认 24h
AGENT_SESSION_SNAPSHOT_TTL_S=86400
# 心跳间隔（秒）：每 interval 秒 POST {JAVA_NOTIFY_URL}/internal/heartbeat
# 让 Java 侧重武装看门狗 TTL（配 0 即关闭心跳）
AGENT_HEARTBEAT_INTERVAL_S=60

# 成片自动拼接（标准模式「一句话生成」）
# 1=开（默认）：任务终态前用本地 ffmpeg 把 N 个分段拼成成片（不消耗 agnes 额度），
#   画廊直接显示「成片 + 分段缩略」，不用再手点「拼接成片」；失败会降级为只给分段并带回原因。
# 画布模式不受此开关影响（那条链路由 synthesizer 拼）。
AGENT_AUTO_STITCH=1

# === 可观测性：LangSmith（P0-2 架包，批次 H）===
# 默认关闭。关闭时不构造 traceable 包装、不初始化客户端（直通，零额外开销）。
# 本项目 LLM 调用是裸 httpx，LangGraph 的自动 tracing 只覆盖图结构事件，
# 捕获不到节点内部的 httpx 调用 —— 所以出站方法（chat / 图像 / 视频）是手动包的。
#
# 打开前提：必须有 key（没 key 会被当成关闭，避免每次调用都刷上报错误）。
# ⚠️ 数值必须写 "true"/"false" 这类字面量，**别写 1/0**：langsmith SDK 自己解析这个
#    变量且不认 1 —— 写 1 时会出现「我们的开关说开、SDK 说没开、traceable 静默直通」：
#    网页上一条 run 都没有、日志也不报错（2026-09-17 实测踩到，已修见 utils/observability.py，
#    但这里也别踩）。
# ⚠️ 端点用**账号所在区域**（LangSmith 设置页会给出确切值；本项目账号是亚太）。
#    亚太端点本机**直连可用**（实测 1.7s）—— 不要为它加 HTTP(S)_PROXY，
#    那会把 agnes 的出站也一起绕进 Clash。
LANGSMITH_TRACING=false
# 你的 LangSmith key：lsv2_pt_ 开头、共 51 位（lsv2_pt_<32位hex>_<10位>）。
# 抄错/少抄一位时读和写会**一律 403**，而报错只说 Forbidden、没有「key 不对」的线索
# （服务侧已加形状告警）。获取：https://smith.langchain.com/ → Settings → API Keys
LANGSMITH_API_KEY=
# LangSmith 网页上的项目分组名（要与你实际打开的项目一致）
LANGSMITH_PROJECT=dreamweaver
# 区域端点：留空会用 SDK 默认（美国），亚太/欧洲账号必须写，否则上报到错区域
LANGSMITH_ENDPOINT=https://apac.api.smith.langchain.com